{
  "name": "cite-hackathon-2026",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CITE Hackathon 2026 — COMSATS University Islamabad, Abbottabad Campus",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start:server": "node server/index.js",
    "preview": "vite preview",
    "test": "node --test",
    "provision:graph-token": "node server/scripts/provision-graph-token.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/analytics": "^2.0.1",
    "concurrently": "^10.0.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "framer-motion": "^11.11.9",
    "helmet": "^8.3.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.9"
  }
}
