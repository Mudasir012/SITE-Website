# ── Supabase (shared) ────────────────────────────────────────────────────────
# The URL is used by both the Vite frontend and the Express backend.
SUPABASE_URL=https://your-project-id.supabase.co
# Public-by-design anon key. Protected by RLS; never put the service-role key here.
SUPABASE_ANON_KEY=your-anon-key-here

# Optional. Leave empty for local development so Vite proxies /api to the
# Express backend. In production, point this at the deployed backend origin.
VITE_API_BASE_URL=

# ── Backend (Express) ─────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Never prefix these with VITE_.
PORT=3001
APP_URL=http://localhost:5173

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Microsoft 365 / Microsoft Graph (delegated Mail.Send) ───────────────────
# Existing Entra public-client registration. These are identifiers, not secrets.
MS_GRAPH_TENANT_ID=75df096c-8b72-48e4-9b91-cbf79d87ee3a
MS_GRAPH_CLIENT_ID=90c11236-10cf-4d46-a53d-7b3900c61369
MS_GRAPH_SENDER_EMAIL=cite@cuiatd.edu.pk
MS_GRAPH_SCOPE="https://graph.microsoft.com/Mail.Send offline_access"

# Bootstrap only. If public.microsoft_graph_token_store has no row, the backend
# writes this token once, encrypted. Remove it from .env after provisioning.
# Never commit the real token.
MS_GRAPH_REFRESH_TOKEN=

# Base64-encoded 32-byte AES-256-GCM key. The backend uses it to encrypt the
# refresh token stored in public.microsoft_graph_token_store. Keep it on the
# server only; losing it requires an authorized interactive re-consent.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MS_GRAPH_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Use "mock" until the encrypted Supabase token row is provisioned.
# Use "graph" to send real mail through Microsoft 365.
EMAIL_PROVIDER=mock

# Optional local outbox folder for mock mode.
MOCK_EMAIL_OUTBOX_DIR=server/.mail-outbox

# Keep false. Only enable for a deliberately isolated non-production test.
ALLOW_MOCK_EMAIL_IN_PRODUCTION=false
